# ═══════════════════════════════════════════════════════════════════
# TeleNOC AI - Configuration
# ═══════════════════════════════════════════════════════════════════
# 
# For judges: NVIDIA_API_KEY is the only required key.
# If no API keys are set, the system falls back to:
#   1. Rule-based classification (works offline)
#   2. Ollama local model (if running)
#
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ─── AI Provider ─────────────────────────────────────────────────
# Primary AI provider (set this for the best experience)
# Get a free NVIDIA API key at https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# Fallback providers (optional)
GROQ_API_KEY=
HF_API_KEY=

# Provider selection: nvidia (default) | groq | huggingface | ollama
LLM_PROVIDER=nvidia

# ─── Backend Configuration ───────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─── Database ────────────────────────────────────────────────────
TELENOC_DB_PATH=/data/telenoc.db

# ─── Ollama (Local Fallback) ─────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama2

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO