# ═══════════════════════════════════════════════════════════════════
# TeleNOC AI - Configuration
# ═══════════════════════════════════════════════════════════════════
#
# !! NEVER put real API keys in this file !!
# This file is committed to the repo as a template.
# Copy it to .env and add your real keys there:
#
#   cp .env.example .env
#   nano .env   # add your keys
#
# .env is listed in .gitignore and will never be committed.
# ═══════════════════════════════════════════════════════════════════

# ─── AI Provider (OpenRouter — free tier) ────────────────────────
# Get a free key at https://openrouter.ai/  (no credit card needed)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Free model to use (auto-falls back to next free model if unavailable)
# Options: nvidia/nemotron-3-ultra-550b-a55b:free   (largest, may be slow)
#          nvidia/nemotron-3-super-120b-a12b:free    (recommended — fast, ~1.5s)
#          google/gemma-4-31b-it:free                (fallback 2)
#          nvidia/nemotron-3-nano-30b-a3b:free       (fallback 3, smallest/fastest)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Fallback providers (optional)
# Get your free Groq key at: console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Get your HuggingFace token at: huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_token_here
# Get your NVIDIA key at: build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
# Model to use via NVIDIA NIM (integrate.api.nvidia.com)
# Full model list: https://build.nvidia.com/explore/discover
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Provider selection: nvidia (default) | openrouter | groq | huggingface
LLM_PROVIDER=nvidia

# ─── OPEA Services ───────────────────────────────────────────────
EMBEDDING_SERVICE_HOST=embedding
EMBEDDING_SERVICE_PORT=6000
RETRIEVER_SERVICE_HOST=retriever
RETRIEVER_SERVICE_PORT=7000
DATAPREP_SERVICE_HOST=dataprep
DATAPREP_SERVICE_PORT=6007
CHATQNA_SERVICE_HOST=chatqna
CHATQNA_SERVICE_PORT=8888
TEI_EMBEDDING_ENDPOINT=http://embedding:6000
REDIS_URL=redis://redis:6379

# ─── Backend Configuration ───────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─── Database ────────────────────────────────────────────────────
TELENOC_DB_PATH=/data/telenoc.db

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── ChromaDB ────────────────────────────────────────────────────────────────
# ChromaDB runs inside Docker — these are the internal service names
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ─── Agent configuration ─────────────────────────────────────────────────────
# How often the autonomous agent polls for new alarms (seconds)
POLL_INTERVAL_SECONDS=30
